@startuml
left to right direction
skinparam packageStyle rectangle

actor Student
actor Administrator

rectangle "Smart Campus Study Room Booking System" {
  usecase "View Room Availability" as UC_ViewAvail
  usecase "Book a Room" as UC_Book
  usecase "Cancel Own Booking" as UC_Cancel
  usecase "Send Confirmation" as UC_Confirm
  usecase "Validate Booking Rules" as UC_Validate
  
  usecase "Block Room" as UC_Block
  usecase "Unblock Room" as UC_Unblock
  usecase "Review Room Usage" as UC_Review
}

' Student Associations
Student -- UC_ViewAvail
Student -- UC_Book
Student -- UC_Cancel

' Administrator Associations
Administrator -- UC_Block
Administrator -- UC_Unblock
Administrator -- UC_Review

' Include Relationships
UC_Book ..> UC_Confirm : <<include>>
UC_Cancel ..> UC_Confirm : <<include>>
UC_Book ..> UC_Validate : <<include>>

' Notes for Rules
note right of UC_Validate
  R1: Future start, duration > 0 and <= 2 hrs
  R2: No overlapping active bookings
  R3: Room must not be blocked
end note

note right of UC_Confirm
  R4: Confirmation produced upon
  successful creation or cancellation
end note

@enduml